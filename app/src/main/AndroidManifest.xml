<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 摇一摇打开 Debug 面板时的振动反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- WebView 容器浏览网页 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络连通性检测（NetworkUtils） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 指纹/生物识别登录（SecureCredentialsManager + BiometricPrompt） -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 语音录制 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 锁屏 / 后台持续录音的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android 13+ 显示录音常驻通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 笔记内拍照插图 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 读取相册/媒体插入图片：Android 13+ 细分媒体权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 12 及以下读取外部存储（13+ 已由上面的细分权限取代） -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 11+ 包可见性：让本应用能发现并使用系统语音识别服务（SpeechRecognizer） -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".NovieApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.App">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links：浏览器输入 https://app.novamind-labs.ai/... 直接调起本应用。
                 autoVerify=true 让系统在安装时校验 /.well-known/assetlinks.json，
                 校验通过后没有“用浏览器还是 App 打开”的选择弹窗。
                 未写 path 过滤 → 该 host 下所有路径都命中，具体页面由 DeepLinks 解析。 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="app.novamind-labs.ai" />
            </intent-filter>
        </activity>

        <!-- WebView 容器：独立进程，崩溃不影响主进程 -->
        <activity
            android:name=".common.web.WebViewActivity"
            android:exported="false"
            android:process=":web"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.App" />

        <!-- PDF 预览页（笔记内 PDF 块全屏阅读，生产使用 → 留在主清单）。
             调试专用页面（接口测试 / 图片上传 / 语音转文字 / Markdown / 文件浏览器）
             已移至 src/debug/AndroidManifest.xml，仅并入 debug 变体。 -->
        <activity
            android:name=".common.pdf.PdfViewerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.App" />

        <!-- 录音前台服务：锁屏/后台持续录音并常驻通知 -->
        <service
            android:name=".common.audio.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Firebase Cloud Messaging 接收服务 -->
        <service
            android:name=".common.push.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- FCM 默认通知渠道：后台仅含 notification 负载的消息由系统直接展示时使用 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="fcm_default" />
        <!-- FCM 默认通知图标与颜色：消息未显式指定时使用 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- 相机拍照写入内部文件需要的 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    
    <!-- Required: set your sentry.io project identifier (DSN) -->
    <meta-data android:name="io.sentry.dsn" android:value="https://feee15a04a70152a416af4ed55791c07@o4510922460758016.ingest.us.sentry.io/4511651077488640" />

    <!-- enable automatic breadcrumbs for user interactions (clicks, swipes, scrolls) -->
    <meta-data android:name="io.sentry.traces.user-interaction.enable" android:value="true" />
    <!-- enable screenshot for crashes (could contain sensitive/PII data) -->
    <meta-data android:name="io.sentry.attach-screenshot" android:value="true" />
    <!-- enable view hierarchy for crashes -->
    <meta-data android:name="io.sentry.attach-view-hierarchy" android:value="true" />

    <!-- enable the performance API by setting a sample-rate, adjust in production env -->
    <meta-data android:name="io.sentry.traces.sample-rate" android:value="1.0" />
</application>

</manifest>