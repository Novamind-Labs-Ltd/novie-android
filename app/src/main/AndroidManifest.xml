<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 摇一摇打开 Debug 面板时的振动反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- WebView 容器浏览网页 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 语音录制 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 锁屏 / 后台持续录音的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android 13+ 显示录音常驻通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NovieApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.App">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WebView 容器：独立进程，崩溃不影响主进程 -->
        <activity
            android:name=".common.web.WebViewActivity"
            android:exported="false"
            android:process=":web"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.App" />

        <!-- 接口测试页（仅 Debug 工具箱跳转） -->
        <activity
            android:name=".debug.apitest.ApiTestActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.App" />

        <!-- 图片上传测试页（仅 Debug 工具箱跳转） -->
        <activity
            android:name=".debug.imageupload.ImageUploadActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.App" />

        <!-- 录音前台服务：锁屏/后台持续录音并常驻通知 -->
        <service
            android:name=".common.audio.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Firebase Cloud Messaging 接收服务 -->
        <service
            android:name=".common.push.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- FCM 默认通知渠道：后台仅含 notification 负载的消息由系统直接展示时使用 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="fcm_default" />

        <!-- 相机拍照写入内部文件需要的 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>