<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 默认：沿用系统信任锚点（其余请求行为不变） -->
    <base-config>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 仅 debuggable 构建信任用户安装的 CA，供 Charles 等 HTTPS 调试代理使用。
         Release 会忽略 debug-overrides，仍只信任上面的系统证书。 -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- 仅对接口测试服务器额外信任其证书；仍执行完整 TLS 校验，不跳过校验。
         同时放开明文 HTTP（用户接口走 http://121.41.207.114:8080）。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">121.41.207.114</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/api_test_cert" />
        </trust-anchors>
    </domain-config>
</network-security-config>
